#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#define BASE 0
#define FN_1 1
#define FN_2 2
#define FN_3 3

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

#include <behaviors/mouse_setting.dtsi>
#include <dt-bindings/zmk/mouse_settings.h>

&lt { flavor = "hold-preferred"; };

/ {
  macros {
    mo_1_kp: mo_1_kp { compatible = "zmk,behavior-macro-one-param"; #binding-cells = <1>; wait-ms = <0>; tap-ms = <0>; bindings = <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER>,
      <&macro_press &mo FN_1>, <&macro_pause_for_release>, <&macro_release &mo FN_1>, <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER>; };
    rgui_kp: rgui_kp { compatible = "zmk,behavior-macro-one-param"; #binding-cells = <1>; wait-ms = <0>; tap-ms = <0>; bindings = <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER>,
      <&macro_press &kp RGUI>, <&macro_pause_for_release>, <&macro_release &kp RGUI>, <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER>; };
  };
  behaviors {
    sq: sq { compatible = "zmk,behavior-sticky-key"; #binding-cells = <1>; release-after-ms = <3000>; quick-release; lazy; ignore-modifiers; bindings = <&kp>; };
    mo_1_kp__sq: mo_1_kp__sq { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "hold-preferred"; tapping-term-ms = <200>; bindings = <&mo_1_kp>, <&sq>; quick-tap-ms = <200>; };
    rgui_kp__to: rgui_kp__to { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "hold-preferred"; tapping-term-ms = <200>; bindings = <&rgui_kp>, <&to>; quick-tap-ms = <200>; };
    rgui_kp__sq: rgui_kp__sq { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "hold-preferred"; tapping-term-ms = <200>; bindings = <&rgui_kp>, <&sq>; quick-tap-ms = <200>; };
    mms_encoder: mms_encoder { compatible = "zmk,behavior-sensor-rotate"; #sensor-binding-cells = <0>; bindings = <&mms MS_TP_SENSITIVITY_DECR>, <&mms MS_TP_SENSITIVITY_INCR>; };
  };
  keymap { compatible = "zmk,keymap";
    BASE { label = "BASE";
      sensor-bindings = < &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT >;
      bindings = <
        &kp Q             &kp W             &kp F             &kp P             &kp B             &kp J             &kp L             &kp U             &kp Y             &kp SEMI
        &kp A             &kp R             &kp S             &kp T             &kp G             &kp M             &kp N             &kp E             &kp I             &kp O
        &kp Z             &kp X             &kp C             &kp D             &kp V             &kp K             &kp H             &kp COMMA         &kp DOT           &kp FSLH
        &kp C_MUTE                          &kp LALT          &lt FN_1 SPACE    &sk LCTRL         &kp RGUI          &kp RSHFT         &kp RCTRL                           &kp C_PP >; };
    FN_1 { label = "FN_1";
      sensor-bindings = < &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT >;
      bindings = <
        &kp PG_UP         &kp BSPC          &kp UP            &kp DEL           &kp HOME          &kp GRAVE         &kp BSLH          &kp LBRC          &kp LBKT          &kp RBKT
        &kp PG_DN         &kp LEFT          &kp DOWN          &kp RIGHT         &kp END           &kp GT            &kp LPAR          &kp MINUS         &kp EQUAL         &kp SQT
        &kp N1            &kp N2            &kp N3            &kp N4            &kp N5            &kp N6            &kp N7            &kp N8            &kp N9            &kp N0
        &trans                              &trans            &trans            &trans            &mt RGUI K_APP    &mt RSHFT SPACE   &caps_word                          &trans >; };
    FN_2 { label = "FN_2";
      sensor-bindings = < &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT >;
      bindings = <
        &kp F12           &kp F9            &kp F8            &kp F7            &kp PSCRN         &kp KP_MINUS      &kp KP_N7         &kp KP_N8         &kp KP_N9         &kp KP_PLUS
        &kp F11           &kp F6            &kp F5            &kp F4            &kp SLCK          &kp KP_MULTIPLY   &kp KP_N4         &kp KP_N5         &kp KP_N6         &kp KP_ENTER
        &kp F10           &kp F3            &kp F2            &kp F1            &kp PAUSE_BREAK   &kp KP_DIVIDE     &kp KP_N1         &kp KP_N2         &kp KP_N3         &kp KP_DOT
        &trans                              &trans            &trans            &to BASE          &mt RGUI KP_NUM   &mt RSHFT KP_N0   &trans                              &trans >; };
    FN_3 { label = "FN_3";
      sensor-bindings = < &mms_encoder &inc_dec_kp C_VOL_DN C_VOL_UP >;
      bindings = <
        &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4      &kp TAB           &kp DEL           &kp UP            &kp BSPC          &kp PG_UP
        &rgb_ug RGB_EFR   &rgb_ug RGB_HUI   &rgb_ug RGB_SAI   &rgb_ug RGB_BRI   &rgb_ug RGB_SPI   &kp ESC           &kp LEFT          &kp DOWN          &kp RIGHT         &kp PG_DN
        &rgb_ug RGB_EFF   &rgb_ug RGB_HUD   &rgb_ug RGB_SAD   &rgb_ug RGB_BRD   &rgb_ug RGB_SPD   &kp ENTER         &mkp LCLK         &mkp MCLK         &mkp RCLK         &kp F4
        &trans                              &bt BT_CLR        &rgb_ug RGB_TOG   &to BASE          &mt RCTRL L       &mt RSHFT SPACE   &mt RALT F11                        &mt RGUI F >; };
  };
  combos { compatible = "zmk,combos";
    layer_0_both_row_0_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <32 33 34 35>; bindings = <&to FN_3>; };
    layer_3_left_row_12_col_01 { timeout-ms = <30>; layers = <FN_3>; key-positions = <13 14 23 24>; bindings = <&bootloader>; };
    layer_3_rght_row_12_col_01 { timeout-ms = <30>; layers = <FN_3>; key-positions = <15 16 25 26>; bindings = <&bootloader>; };

    layer_0_left_row_3_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <3 4>;   bindings = <&kp C_VOL_UP>; };
    layer_0_left_row_3_col_12  { timeout-ms = <30>; layers = <BASE>; key-positions = <2 3>;   bindings = <&kp INS>; };
    layer_0_left_row_3_col_23  { timeout-ms = <30>; layers = <BASE>; key-positions = <1 2>;   bindings = <&kp TAB>; };
    layer_0_left_row_3_col_34  { timeout-ms = <30>; layers = <BASE>; key-positions = <0 1>;   bindings = <&kp CAPS>; };
    layer_0_left_row_2_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <13 14>; bindings = <&kp C_VOL_DN>; };
    layer_0_left_row_2_col_12  { timeout-ms = <10>; layers = <BASE>; key-positions = <12 13>; bindings = <&kp ENTER>; };
    layer_0_left_row_2_col_23  { timeout-ms = <10>; layers = <BASE>; key-positions = <11 12>; bindings = <&kp ESC>; };
    layer_0_left_row_2_col_34  { timeout-ms = <10>; layers = <BASE>; key-positions = <10 11>; bindings = <&kp SPACE>; };
    layer_0_left_row_1_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <23 24>; bindings = <&kp C_MUTE>; };
    layer_0_left_row_1_col_12  { timeout-ms = <20>; layers = <BASE>; key-positions = <22 23>; bindings = <&mkp LCLK>; };
    layer_0_left_row_1_col_23  { timeout-ms = <30>; layers = <BASE>; key-positions = <21 22>; bindings = <&mkp MCLK>; };
    layer_0_left_row_1_col_34  { timeout-ms = <30>; layers = <BASE>; key-positions = <20 21>; bindings = <&mkp RCLK>; };

    layer_0_rght_row_3_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <5 6>;   bindings = <&kp C_PREV>; };
    layer_0_rght_row_3_col_12  { timeout-ms = <30>; layers = <BASE>; key-positions = <6 7>;   bindings = <&mkp MB4>; };
    layer_0_rght_row_3_col_23  { timeout-ms = <30>; layers = <BASE>; key-positions = <7 8>;   bindings = <&msc SCRL_UP>; };
    layer_0_rght_row_3_col_34  { timeout-ms = <30>; layers = <BASE>; key-positions = <8 9>;   bindings = <&mkp MB5>; };
    layer_0_rght_row_2_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <15 16>; bindings = <&kp C_NEXT>; };
    layer_0_rght_row_2_col_12  { timeout-ms = <10>; layers = <BASE>; key-positions = <16 17>; bindings = <&msc SCRL_LEFT>; };
    layer_0_rght_row_2_col_23  { timeout-ms = <10>; layers = <BASE>; key-positions = <17 18>; bindings = <&msc SCRL_DOWN>; };
    layer_0_rght_row_2_col_34  { timeout-ms = <10>; layers = <BASE>; key-positions = <18 19>; bindings = <&msc SCRL_RIGHT>; };
    layer_0_rght_row_1_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <25 26>; bindings = <&kp C_PP>; };
    layer_0_rght_row_1_col_12  { timeout-ms = <20>; layers = <BASE>; key-positions = <26 27>; bindings = <&mkp LCLK>; };
    layer_0_rght_row_1_col_23  { timeout-ms = <30>; layers = <BASE>; key-positions = <27 28>; bindings = <&mkp MCLK>; };
    layer_0_rght_row_1_col_34  { timeout-ms = <30>; layers = <BASE>; key-positions = <28 29>; bindings = <&mkp RCLK>; };

    layer_1_left_row_3_col_01  { timeout-ms = <30>; layers = <FN_1>; key-positions = <3 4>;   bindings = <&kp F12>; };
    layer_1_left_row_3_col_12  { timeout-ms = <30>; layers = <FN_1>; key-positions = <2 3>;   bindings = <&kp F7>; };
    layer_1_left_row_3_col_23  { timeout-ms = <30>; layers = <FN_1>; key-positions = <1 2>;   bindings = <&kp F8>; };
    layer_1_left_row_3_col_34  { timeout-ms = <30>; layers = <FN_1>; key-positions = <0 1>;   bindings = <&kp F9>; };
    layer_1_left_row_2_col_01  { timeout-ms = <30>; layers = <FN_1>; key-positions = <13 14>; bindings = <&kp F11>; };
    layer_1_left_row_2_col_12  { timeout-ms = <30>; layers = <FN_1>; key-positions = <12 13>; bindings = <&kp F4>; };
    layer_1_left_row_2_col_23  { timeout-ms = <30>; layers = <FN_1>; key-positions = <11 12>; bindings = <&kp F5>; };
    layer_1_left_row_2_col_34  { timeout-ms = <30>; layers = <FN_1>; key-positions = <10 11>; bindings = <&kp F6>; };
    layer_1_left_row_1_col_01  { timeout-ms = <30>; layers = <FN_1>; key-positions = <23 24>; bindings = <&kp F10>; };
    layer_1_left_row_1_col_12  { timeout-ms = <30>; layers = <FN_1>; key-positions = <22 23>; bindings = <&kp F1>; };
    layer_1_left_row_1_col_23  { timeout-ms = <30>; layers = <FN_1>; key-positions = <21 22>; bindings = <&kp F2>; };
    layer_1_left_row_1_col_34  { timeout-ms = <30>; layers = <FN_1>; key-positions = <20 21>; bindings = <&kp F3>; };

    layer_1_rght_row_3_col_01  { timeout-ms = <30>; layers = <FN_1>; key-positions = <5 6>;   bindings = <&kp PSCRN>; };
    layer_1_rght_row_2_col_01  { timeout-ms = <30>; layers = <FN_1>; key-positions = <15 16>; bindings = <&kp SLCK>; };
    layer_1_rght_row_1_col_01  { timeout-ms = <30>; layers = <FN_1>; key-positions = <25 26>; bindings = <&kp PAUSE_BREAK>; };

    layer_0_left_row_0_col_12  { timeout-ms = <30>; layers = <BASE>; key-positions = <31 32>; bindings = <&mo_1_kp__sq LALT LGUI>; };
    layer_0_left_row_0_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <32 33>; bindings = <&mo_1_kp__sq LCTRL LSHFT>; };
    layer_0_both_row_0_col_0   { timeout-ms = <30>; layers = <BASE>; key-positions = <33 34>; bindings = <&rgui_kp__to LCTRL FN_2>; };
    layer_0_rght_row_0_col_01  { timeout-ms = <30>; layers = <BASE>; key-positions = <34 35>; bindings = <&rgui_kp__sq RSHFT RALT>; };
  };
};
